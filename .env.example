# ATS Resume Intelligence Platform Environment Variables
# Copy this file to .env and fill in your API key(s)

# Gemini API Key (Enables live multi-agent LLM analysis & response generation)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Hugging Face API Key
# HUGGINGFACE_API_KEY=your_hf_token_here
# HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Provider selection (gemini or huggingface)
# LLM_PROVIDER=huggingface

# Force Mock AI mode (Set to True if you want to force offline rule engines even with keys set)
FORCE_MOCK_AI=False
